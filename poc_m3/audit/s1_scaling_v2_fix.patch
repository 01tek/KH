+SEP = 0  # NeoX <|endoftext|>; NB 50256 is a 22-space token in this vocab, not EOS
+
+def make_ar_batch(ctx, bs, rng, n_pairs=16, n_q=4):
+    """Associative recall. n_pairs random (key,value) bigrams in the first quarter of a
+    random-token haystack; n_q queries 'SEP key' at the end. The label sits on the query-key
+    position (next-token target = its value), so the answer is never visible at a scored position."""
+    X = torch.empty(bs, ctx, dtype=torch.long); Y = torch.full((bs, ctx), -100, dtype=torch.long)
+    for b in range(bs):
+        kv = rng.sample(range(5000, 50255), 2 * n_pairs); keys, vals = kv[:n_pairs], kv[n_pairs:]
+        seq = [rng.randint(1000, 4999) for _ in range(ctx)]
+        p = rng.randint(1, ctx // 4 - 2 * n_pairs)
+        for i in range(n_pairs): seq[p + 2 * i], seq[p + 2 * i + 1] = keys[i], vals[i]
+        for j, i in enumerate(rng.sample(range(n_pairs), n_q)):
+            q = ctx - 2 * n_q + 2 * j; seq[q], seq[q + 1] = SEP, keys[i]; Y[b, q + 1] = vals[i]
+        X[b] = torch.tensor(seq)
+    return X.to(DVC), Y.to(DVC)
+
